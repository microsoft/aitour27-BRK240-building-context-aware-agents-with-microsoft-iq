/// Synthetic supplier performance analytics for Caldova. SupplierPerformance contains weekly snapshots; DimSupplier contains canonical Waypoint supplier identity.
model Model
	culture: en-US
	collation: Latin1_General_100_BIN2_UTF8
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_ProTooling = ["SLL"]

ref table DimDate
ref table DimSupplier
ref table SupplierPerformance
ref table DimLocation
ref table DimInspectionResult
ref table DimAuditResult
ref table DimFinancialRating