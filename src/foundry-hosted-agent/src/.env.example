# Standalone Caldova Supply Foundry agent — environment template.
#
# Copy to `.env` (next to main.py) to run locally with `python main.py`, or use as
# a reference for the values deploy.ps1 injects into the container at deploy time.
# In production these are set as the hosted agent's environment_variables.

# ── Target IQ project (where the 3 IQ connections live) + model ────────────────
# The agent calls the Responses API on THIS endpoint so project_connection_id
# tool references resolve server-side.
IQ_PROJECT_ENDPOINT=https://<iq-account>.services.ai.azure.com/api/projects/<iq-project>
FOUNDRY_MODEL_NAME=gpt-5.4-mini
IQ_REASONING_EFFORT=low

# ── The three IQs (Foundry project connections) ────────────────────────────────
# Fabric IQ — the Caldova SupplierDataAgent connection (full ARM resource id).
FABRIC_CONNECTION_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<iq-account>/projects/<iq-project>/connections/caldova-supply-dataagent

# Foundry IQ — the Caldova knowledge base (Azure AI Search) MCP.
FOUNDRYIQ_CONNECTION_ID=caldova-supply-kb
FOUNDRYIQ_MCP_URL=https://<search-service>.search.windows.net/knowledgebases/caldova-supply-kb/mcp?api-version=2026-05-01-preview

# Web IQ — real-time web search MCP (connection name; URL defaults to api.microsoft.ai/v3/mcp).
WEB_IQ_CONNECTION_ID=WebIQ
# WEB_IQ_MCP_URL=https://api.microsoft.ai/v3/mcp

# Work IQ — unified Work IQ MCP (mailbox / chat). Resolved as the agent-user via OBO.
WORK_IQ_CONNECTION_ID=WorkIQ
# WORK_IQ_MCP_URL=https://workiq.svc.cloud.microsoft/mcp

# ── Agentic OBO (real user passthrough) ────────────────────────────────────────
# The agent mints user-delegated tokens AS a provisioned Agent 365 agent-user (which
# owns the demo mailbox + has Fabric access) via a 3-leg exchange:
#   blueprint (client_secret + fmi_path=ServiceIdentity)
#   -> instance (ServiceIdentity client_assertion)
#   -> user_fic (user_id = agent-user object id)
# This makes ALL FOUR IQs resolve with real data, independent of who is chatting.
TENANT_ID=<tenant-guid>
OBO_BLUEPRINT_CLIENT_ID=<agent-identity blueprint app id>
OBO_BLUEPRINT_SECRET=<blueprint client secret>
OBO_INSTANCE_CLIENT_ID=<ServiceIdentity SP app/object id>
OBO_AGENT_USER_ID=<agent-user Entra object id>

# ── Auth (local dev only) ──────────────────────────────────────────────────────
# In the container the agent uses its managed identity (client id injected as
# FOUNDRY_AGENT_DEFAULT_INSTANCE_CLIENT_ID). Locally, DefaultAzureCredential /
# az login is used. Optionally pin an API key instead:
# AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-11-15-preview

# ── HTTP server ────────────────────────────────────────────────────────────────
PORT=8088
HOST=0.0.0.0
LOG_LEVEL=INFO
